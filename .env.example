# EVM — one key/address works across all six EVM chains. Hex with 0x prefix.
EVM_PRIVATE_KEY=0x...

# Ethereum requires its own RPC (public L1 endpoints are unreliable).
ETHEREUM_RPC_URL=https://...

# Optional — each falls back to a default public RPC when unset.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
HYPEREVM_RPC_URL=
ROBINHOOD_RPC_URL=

# Solana — both required to enable Solana.
SOLANA_PRIVATE_KEY=          # base58 secret key (Phantom export format)
SOLANA_RPC_URL=https://...

# Auth
ADMIN_PASSWORD=
SESSION_SECRET=              # random 32+ chars, for cookie signing
