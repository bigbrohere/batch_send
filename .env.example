# EVM — one key/address works across all six EVM chains. Hex with 0x prefix.
# Multiple senders: put several keys here separated by commas/newlines, or use
# EVM_PRIVATE_KEYS. Each distinct key becomes a selectable sender in the UI.
EVM_PRIVATE_KEY=0x...
# EVM_PRIVATE_KEYS=0xkey1,0xkey2

# Ethereum requires its own RPC (public L1 endpoints are unreliable).
ETHEREUM_RPC_URL=https://...

# Optional — each falls back to a default public RPC when unset.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
HYPEREVM_RPC_URL=
ROBINHOOD_RPC_URL=

# Solana — both required to enable Solana.
SOLANA_PRIVATE_KEY=          # base58 secret key (Phantom export format)
# Multiple Solana senders: comma/newline-separate several keys here, or use
# SOLANA_PRIVATE_KEYS. Each distinct key becomes a selectable sender.
# SOLANA_PRIVATE_KEYS=key1,key2
SOLANA_RPC_URL=https://...

# Auth
ADMIN_PASSWORD=
SESSION_SECRET=              # random 32+ chars, for cookie signing
